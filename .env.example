# Generate independent local tokens with: python scripts/init_env.py
RUNNER_TOKEN=
OPERATOR_TOKEN=
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8000
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8765
# Default uses only the bundled HTML UI; no browser network navigation is needed.
DEFAULT_TARGET=sandbox://legacy
TARGET_ORIGIN=http://127.0.0.1:8765
POLICY_FILE=config/policy.json
DATA_DIR=.runtime
# Blank uses Playwright's installed Chromium. A system Chromium path is also supported.
CHROMIUM_EXECUTABLE=
HEADLESS=true
ACTION_TIMEOUT_MS=3000
RUN_TIMEOUT_SECONDS=180
INTERVENTION_TIMEOUT_SECONDS=90
HUMAN_LEASE_SECONDS=60
MAX_STEPS=24
MAX_ACTIVE_RUNS=4
# openai is the unattended production adapter. No key is needed for replay.
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
# Explicit alternative: MODEL_PROVIDER=bridge for an external LLM to supply decisions.
# This is NOT an offline scripted agent; it waits for real external model decisions.
BRIDGE_DIR=.bridge
MODEL_TIMEOUT_SECONDS=45
