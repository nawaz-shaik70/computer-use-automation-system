  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "extract"
            ],
            "title": "Kind"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "parameter": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameter"
          },
          "output": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "Action"
      },
      "Capability": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Name"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "app_family": {
            "type": "string",
            "const": "legacy-servicing",
            "title": "App Family",
            "default": "legacy-servicing"
          },
          "app_version": {
            "type": "string",
            "const": "1",
            "title": "App Version",
            "default": "1"
          },
          "profile_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Profile Digest"
          },
          "entry_path": {
            "type": "string",
            "const": "/legacy",
            "title": "Entry Path",
            "default": "/legacy"
          },
          "inputs": {
            "patternProperties": {
              "^[a-z][a-z0-9_]{0,63}$": {
                "$ref": "#/components/schemas/Parameter"
              }
            },
            "type": "object",
            "title": "Inputs"
          },
          "outputs": {
            "patternProperties": {
              "^[a-z][a-z0-9_]{0,63}$": {
                "$ref": "#/components/schemas/Parameter"
              }
            },
            "type": "object",
            "title": "Outputs"
          },
          "targets": {
            "patternProperties": {
              "^[a-z][a-z0-9_]{0,63}$": {
                "$ref": "#/components/schemas/TargetSpec"
              }
            },
            "type": "object",
            "title": "Targets"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 2,
            "title": "Steps"
          },
          "checkpoint": {
            "$ref": "#/components/schemas/Checkpoint"
          },
          "error_handlers": {
            "items": {
              "$ref": "#/components/schemas/ErrorHandler"
            },
            "type": "array",
            "title": "Error Handlers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "revision",
          "profile_digest",
          "inputs",
          "outputs",
          "targets",
          "steps",
          "checkpoint",
          "error_handlers"
        ],
        "title": "Capability"
      },
      "Checkpoint": {
        "properties": {
          "screen": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Screen"
          },
          "required_outputs": {
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Required Outputs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "screen",
          "required_outputs"
        ],
        "title": "Checkpoint"
      },
      "DiscoveryRequest": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 6,
            "title": "Goal"
          },
          "inputs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inputs"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
